    "judgment.evidence.slot-001": {
      "value": "示例反馈集中在版本与检索，维护应先处理这两类"
    },
    "judgment.evidence.slot-002": {
      "value": "单位：条；合成反馈样本。类别互斥，每条仅归入一个主要问题"
    },
    "judgment.evidence.slot-003": {
      "value": "先处理主要问题"
    },
    "judgment.evidence.slot-004": {
      "value": "版本识别与资料检索是这批反馈的主要来源。"
    },
    "judgment.evidence.slot-005": {
      "value": "先使当前版本可辨、入口可找到，再复核描述与权限问题。"
    },
    "judgment.evidence.slot-006": {
      "value": "判断只适用于这批反馈"
    },
    "judgment.evidence.slot-007": {
      "value": "反馈条数不是全部用户的发生率，也不能说明问题造成的损失。"
    },
    "judgment.evidence.slot-008": {
      "value": "实际优先级仍需结合影响范围和处理成本。"
    },
    "judgment.evidence.slot-009": {
      "value": "原创合成内容 · 可计算结构样例 10/10"
    }
