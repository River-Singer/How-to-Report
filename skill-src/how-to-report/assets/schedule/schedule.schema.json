{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScheduleSpec 0.1",
  "description": "Optional structured input for offline date/state checking, not a required report template. schedule_core.validate also checks chronology, baseline identity, source references, object IDs and dependencies. Bounds limit local processing; they do not prescribe report length or prove business truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_version",
    "title",
    "as_of",
    "calendar",
    "refs",
    "tasks"
  ],
  "properties": {
    "schedule_version": {
      "const": "0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "calendar": {
      "const": "calendar_days"
    },
    "refs": {
      "$ref": "#/$defs/refs"
    },
    "baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/baseline"
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "milestones": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "snapshots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "actions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "limits": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/text300"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[0-9]{2}|20[0-9]{2}|2100)-[0-9]{2}-[0-9]{2}$"
    },
    "text300": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "text600": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "approved_on",
        "refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "approved_on": {
          "$ref": "#/$defs/date"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "finish": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis",
        "refs"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "basis": {
          "$ref": "#/$defs/text300"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_submitted",
            "pending",
            "accepted",
            "rejected",
            "unknown"
          ]
        },
        "criteria": {
          "$ref": "#/$defs/text600"
        },
        "result": {
          "$ref": "#/$defs/text600"
        },
        "scope": {
          "$ref": "#/$defs/text600"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "criteria",
              "result",
              "scope",
              "refs"
            ]
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state",
        "refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "state": {
          "enum": [
            "not_started",
            "active",
            "blocked",
            "done"
          ]
        },
        "refs": {
          "$ref": "#/$defs/refs"
        },
        "owner": {
          "$ref": "#/$defs/text300"
        },
        "condition": {
          "$ref": "#/$defs/text300"
        },
        "baseline": {
          "$ref": "#/$defs/interval"
        },
        "actual": {
          "$ref": "#/$defs/interval"
        },
        "forecast": {
          "$ref": "#/$defs/interval"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "refs": {
          "$ref": "#/$defs/refs"
        },
        "baseline_date": {
          "$ref": "#/$defs/date"
        },
        "actual_date": {
          "$ref": "#/$defs/date"
        },
        "forecast_date": {
          "$ref": "#/$defs/date"
        },
        "condition": {
          "$ref": "#/$defs/text300"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "lag",
        "refs"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "FS"
        },
        "lag": {
          "type": "integer",
          "const": 0
        },
        "refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_on",
        "baseline_ref",
        "forecasts"
      ],
      "properties": {
        "reported_on": {
          "$ref": "#/$defs/date"
        },
        "baseline_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "forecasts": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "milestone_id",
              "date",
              "refs"
            ],
            "properties": {
              "milestone_id": {
                "$ref": "#/$defs/id"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "refs": {
                "$ref": "#/$defs/refs"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_ids",
        "reason"
      ],
      "properties": {
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "milestone_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reason": {
          "$ref": "#/$defs/text600"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "$ref": "#/$defs/text600"
        },
        "refs": {
          "$ref": "#/$defs/refs"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "due": {
          "$ref": "#/$defs/date"
        }
      }
    }
  }
}
